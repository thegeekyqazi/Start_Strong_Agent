# Copy to .env (make bootstrap does this if .env is absent). .env is git-ignored.
# API/server-side settings only. Nothing here is read by the web build.

# local | test | production
STRONGSTART_ENVIRONMENT=local
# none (default; protected operations deny) | fixture (LOCAL ONLY demo identity; rejected in production)
STRONGSTART_AUTH_MODE=none
# Local Docker Compose database (infra/compose.yaml). Local dev placeholder password, not a secret.
STRONGSTART_DATABASE_URL=postgresql+psycopg://strongstart:strongstart_local_dev@127.0.0.1:55432/strongstart
STRONGSTART_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Provider credentials: optional, unused by INIT-001. Leave empty; never commit real values.
STRONGSTART_GEMINI_API_KEY=
STRONGSTART_TAVILY_API_KEY=
STRONGSTART_FIRECRAWL_API_KEY=

# Funding discovery/capture (B1-DISC-001). "live" without a key = explicitly unavailable;
# "fixture" = labelled synthetic providers (local/test only; rejected in production).
STRONGSTART_FUNDING_SEARCH_MODE=live
STRONGSTART_FUNDING_CAPTURE_MODE=live
STRONGSTART_FUNDING_MAX_RESULTS=5
STRONGSTART_FUNDING_SEARCH_TIMEOUT_SECONDS=15
STRONGSTART_FUNDING_CAPTURE_TIMEOUT_SECONDS=45
STRONGSTART_FUNDING_MAX_CAPTURE_BYTES=2000000
# Development-only local capture store (per checkout/worktree; git-ignored).
STRONGSTART_FUNDING_CAPTURE_STORE_DIR=.local-data/funding-captures
# Optional JSON discovery seed of official source hosts (not an eligibility shortlist).
# STRONGSTART_FUNDING_SOURCE_SEED_PATH=
